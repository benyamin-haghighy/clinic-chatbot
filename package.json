{
  "name": "chatbot",
  "version": "1.0.0",
  "description": "RAG chatbot for clinics: answers patients' questions from the clinic's own information",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:create": "sequelize-cli db:create --config src/config/config.json",
    "db:migrate": "sequelize-cli db:migrate --config src/config/config.json --migrations-path src/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/config/config.json --migrations-path src/migrations",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all --config src/config/config.json --migrations-path src/migrations",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate",
    "db:drop": "sequelize-cli db:drop --config src/config/config.json",
    "seed": "node seed.js"
  },
  "keywords": ["chatbot", "rag", "embeddings", "clinic", "nodejs", "express"],
  "author": "benyamin",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.3",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4",
    "passport": "^0.7.0",
    "passport-cookie": "^1.0.9",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "yup": "^1.7.1"
  }
}